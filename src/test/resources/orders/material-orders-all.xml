<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Material Orders all" verbose="1" parallel="none" thread-count="1" preserve-order="true">
  <listeners><listener class-name="com.l2b.vendor.environment.TestListener"/></listeners>
  <test name="Orders-Dump" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.MaterialOrdersDump"/>
  </classes></test>
  <test name="Orders-Landing" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.MaterialOrdersLandingTest"/>
  </classes></test>
  <test name="Orders-Interact" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.MaterialOrdersInteractTest"/>
  </classes></test>
  <test name="Orders-Edge" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.MaterialOrdersEdgeTest"/>
  </classes></test>
</suite>
