<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Order details all" verbose="1" parallel="none" thread-count="1" preserve-order="true">
  <listeners><listener class-name="com.l2b.vendor.environment.TestListener"/></listeners>
  <test name="Details-Dump" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.OrderDetailsDump"/>
  </classes></test>
  <test name="Details-Landing" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.OrderDetailsLandingTest"/>
  </classes></test>
  <test name="Details-Interact" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.OrderDetailsInteractTest"/>
  </classes></test>
  <test name="Details-Edge" preserve-order="true"><classes>
    <class name="com.l2b.vendor.modules.orders.presentation.tests.OrderDetailsEdgeTest"/>
  </classes></test>
</suite>
