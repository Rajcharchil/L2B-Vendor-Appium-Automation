<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Category all" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="Category-Dump" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.CategoryDump"/>
        </classes>
    </test>
    <test name="Category-Landing" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.CategoryLandingTest"/>
        </classes>
    </test>
    <test name="Category-Interact" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.CategoryInteractTest"/>
        </classes>
    </test>
    <test name="Category-Edge" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.CategoryEdgeTest"/>
        </classes>
    </test>
</suite>
