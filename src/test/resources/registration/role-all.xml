<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="L2B Vendor Role all" verbose="1" parallel="none" thread-count="1" preserve-order="true">
    <listeners>
        <listener class-name="com.l2b.vendor.environment.TestListener"/>
    </listeners>
    <test name="Role-Dump" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.RoleDump"/>
        </classes>
    </test>
    <test name="Role-Landing" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.RoleLandingTest"/>
        </classes>
    </test>
    <test name="Role-Interact" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.RoleInteractTest"/>
        </classes>
    </test>
    <test name="Role-Edge" preserve-order="true">
        <classes>
            <class name="com.l2b.vendor.modules.onboarding.presentation.tests.RoleEdgeTest"/>
        </classes>
    </test>
</suite>
